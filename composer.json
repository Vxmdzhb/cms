            "url": "https://github.com/Vxmdzhb/auth"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/api"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/http"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/i18n"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/session"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/kernel"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/routing"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/template"
        },
        {
