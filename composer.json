{
    "name": "astrx/cms",
    "description": "AstrX CMS core: accounts, admin panel, pages, navigation, themes, comments, news, invites and data retention",
    "license": "LicenseRef-DoWhatever",
    "type": "library",
    "keywords": [
        "astrx",
        "no-javascript",
        "server-rendered",
        "cms"
    ],
    "homepage": "https://github.com/Vxmdzhb/cms",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "astrx/api": "self.version",
        "astrx/auth": "self.version",
        "astrx/captcha": "self.version",
        "astrx/config": "self.version",
        "astrx/csrf": "self.version",
        "astrx/error-handler": "self.version",
        "astrx/http": "self.version",
        "astrx/i18n": "self.version",
        "astrx/identicon": "self.version",
        "astrx/image": "self.version",
        "astrx/kernel": "self.version",
        "astrx/mail": "self.version",
        "astrx/module": "self.version",
        "astrx/pagination": "self.version",
        "astrx/result": "self.version",
        "astrx/routing": "self.version",
        "astrx/session": "self.version",
        "astrx/support": "self.version",
        "astrx/template": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AstrX\\User\\": "User/",
            "AstrX\\Admin\\": "Admin/",
            "AstrX\\Page\\": "Page/",
            "AstrX\\Navbar\\": "Navbar/",
            "AstrX\\Theme\\": "Theme/",
            "AstrX\\Comment\\": "Comment/",
            "AstrX\\News\\": "News/",
            "AstrX\\Invite\\": "Invite/",
            "AstrX\\Retention\\": "Retention/"
        }
    },
    "extra": {
        "astrx": {
            "resources": "resources"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/result"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/support"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/config"
        },
        {
